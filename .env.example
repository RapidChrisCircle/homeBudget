# Copy to .env for local development (backend/app/database.py loads this via
# pydantic-settings). Not used by the QNAP deployment - Container Station
# does not read .env files, so those variables are entered directly in the
# Container Station "Create Application" form instead (see docker-compose.qnap.yml).

DATABASE_HOST=postgres-1
DATABASE_PORT=5432
DATABASE_NAME=home
DATABASE_USER=homeuser
DATABASE_PASSWORD=yourpassword

# Comma-separated list of origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement (verbose - dev only).
DEBUG_SQL=false
